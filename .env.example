# Phase 1 + Phase 2 local/production settings. Never commit real secrets.
APP_ENV=development
HTTP_PORT=8080

# Runtime API role (NOBYPASSRLS). Migrations use a separate owner role.
DATABASE_URL=postgres://pricing_app:pricing_app_dev_only@localhost:5432/pricing?sslmode=disable
MIGRATION_DATABASE_URL=postgres://pricing:pricing_dev_only@localhost:5432/pricing?sslmode=disable
WORKER_DATABASE_URL=postgres://pricing_worker:pricing_worker_dev_only@localhost:5432/pricing?sslmode=disable
ADMIN_DATABASE_URL=postgres://pricing_worker:pricing_worker_dev_only@localhost:5432/pricing?sslmode=disable

CORS_ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_SECRET=change-me-in-production-must-be-32-chars!!
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

POSTGRES_USER=pricing
POSTGRES_PASSWORD=pricing_dev_only
POSTGRES_DB=pricing

# Public callback base used when registering WooCommerce webhooks.
WOOCOMMERCE_WEBHOOK_BASE_URL=http://localhost:8080
WOOCOMMERCE_ALLOW_INSECURE=true
WOOCOMMERCE_ALLOW_PRIVATE_NETWORKS=true
RECONCILIATION_INTERVAL_MINUTES=15

# Phase 4 approved competitor sources. Comma-separated exact domains; no arbitrary crawling.
COMPETITOR_ALLOWED_DOMAINS=competitor.example.com
COMPETITOR_CHECK_INTERVAL_MINUTES=360
COMPETITOR_FRESHNESS_MINUTES=720
COMPETITOR_ALLOW_PRIVATE_NETWORKS=false

# Phase 5 recommendation generation and publishing.
# RECOMMENDATION_INTERVAL_MINUTES controls how often recommendations are recomputed.
# RECOMMENDATION_TTL_MINUTES controls how long a recommendation stays valid before it must be recomputed.
RECOMMENDATION_INTERVAL_MINUTES=15
RECOMMENDATION_TTL_MINUTES=30

# Phase 7 AI governance. Leave the provider unset to run on the static provider:
# every governance path stays exercisable without an outbound model call.
# AI_PROVIDER_URL=https://api.openai.com/v1/chat/completions
# AI_PROVIDER_API_KEY=
# AI_MODEL=
AI_REQUESTS_PER_MINUTE=10

# Phase 8 billing, via Paystack.
#
# PAYSTACK_SECRET_KEY is server-side only. It is never stored in the database,
# never returned to a client, and never logged. Leave it unset to run without
# payments: plans, entitlements, usage metering, and read-only mode all still
# work, and only checkout is disabled. Get the key from the Paystack dashboard
# and set the dashboard's webhook URL to <PUBLIC_BASE>/api/v1/webhooks/paystack.
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# BILLING_GRACE_DAYS is how long a store keeps full access after a failed
# payment before it becomes read-only. Zero would make a transient card decline
# an instant lockout, so it is deliberately not zero.
# BILLING_GRACE_DAYS=7
# BILLING_RETENTION_DAYS is how long business data is retained after
# cancellation. Nothing is ever deleted on nonpayment or cancellation; this
# bounds how long operational noise is kept.
# BILLING_RETENTION_DAYS=90
# BILLING_CALLBACK_URL is where Paystack returns the browser after checkout.
# BILLING_CALLBACK_URL=http://localhost:3001/app
# BILLING_DUNNING_INTERVAL_MINUTES is how often the worker expires grace periods
# and lapsed trials. Read-only mode is enforced from stored state, so this loop
# is what actually makes a grace period end.
# BILLING_DUNNING_INTERVAL_MINUTES=15

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
